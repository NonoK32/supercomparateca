# Copia este archivo a .env y rellena los valores reales.
# .env está en .gitignore y NUNCA debe subirse al repositorio.
# docker-compose lee estas variables.

# ---- Base de datos (PostgreSQL) ----
POSTGRES_USER=supercomparateca
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=supercomparateca

# ---- OCR ----
# Idioma de Tesseract (la imagen incluye 'spa').
OCR_LANG=spa

# ---- API ----
# OBLIGATORIO. La API NO arranca con este placeholder: genera uno real con
#   openssl rand -hex 32
JWT_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Matching por similitud (EPIC 10) ----
# Por encima de UMBRAL_AUTO la línea se asocia sola; entre UMBRAL_SUGERENCIA y
# UMBRAL_AUTO se propone al usuario. Súbelos si ves falsos positivos, bájalos
# si el sistema pregunta demasiado.
UMBRAL_AUTO=0.92
UMBRAL_SUGERENCIA=0.70

# ---- Anti-bot en el registro (Cloudflare Turnstile) ----
# Se sacan de https://dash.cloudflare.com -> Turnstile -> Add widget.
# Funciona en cualquier web: NO hace falta tener el dominio proxificado por
# Cloudflare (nube naranja).
#
# Si TURNSTILE_SECRET_KEY se deja vacía, la verificación queda DESACTIVADA y el
# registro es abierto. En desarrollo es lo cómodo; en producción, definir las
# dos. La de sitio es pública (el navegador la ve); la secreta no sale del
# servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email de una cuenta QUE YA EXISTE. Lo usa scripts/smoke.sh para comprobar que
# el anti-bot esta activo de verdad sin llegar a crear ningun usuario: el api
# verifica Turnstile antes de mirar la base de datos, asi que un email ya
# registrado da 400 si el filtro esta puesto y 409 si no lo esta.
# Sin esto el smoke test falla a proposito, en vez de pasar sin comprobar nada.
SMOKE_EMAIL=

# ---- Correo transaccional (Resend) ----
# Confirmación de la dirección al registrarse y recuperación de contraseña.
# Sin RESEND_API_KEY no se envía nada: los mensajes se escriben en el log del
# api, lo cual va bien en desarrollo (el enlace sale en `docker compose logs
# api`) pero en producción significa que NADIE puede darse de alta, porque sin
# confirmar el correo no se puede entrar. El smoke test lo comprueba.
#
# El dominio del remitente tiene que estar verificado en Resend, con sus
# registros SPF y DKIM en el DNS, o los correos se rechazan o van a spam.
RESEND_API_KEY=
CORREO_REMITENTE=SuperComparateca <no-reply@supercomparateca.com>
# Base de los enlaces que se mandan por correo: apunta al FRONTEND, que es
# quien los abre. En producción, https://tu-dominio
FRONTEND_URL=http://localhost:8090

# ---- Acceso con Google ----
# Id de cliente OAuth (Google Cloud → API y servicios → Credenciales → ID de
# cliente de OAuth → Aplicación web). Es PÚBLICO: viaja en el HTML de cualquier
# web que use Google Identity Services, y el frontend lo pide en
# GET /auth/config. No hace falta secreto de cliente: usamos el flujo de ID
# token, no el de código de autorización.
#
# En «Orígenes autorizados de JavaScript» hay que poner el dominio del FRONTEND
# (https://tu-dominio, y http://localhost:8090 para desarrollo). No hace falta
# URI de redirección. Vacío = el botón no se pinta y solo se entra con email y
# contraseña, que es lo cómodo en desarrollo.
GOOGLE_CLIENT_ID=

# ---- Producción (solo con docker-compose.prod.yml / Traefik) ----
# Etiqueta de las imágenes de GHCR que despliega producción. `main` es la
# móvil: siempre lo último integrado. Para volver atrás, poner aquí el SHA
# completo del commit al que se quiere regresar y redesplegar.
IMAGE_TAG=main
# Dominio real apuntando al servidor y email para Let's Encrypt.
DOMAIN=supercomparateca.example.com
ACME_EMAIL=tu-email@example.com

# CA de ACME. Si se deja vacía se usa la de PRODUCCIÓN de Let's Encrypt.
# Para ENSAYAR el despliegue sin gastar cuota, descomenta la de staging: emite
# certificados que el navegador no reconoce (verás un aviso de seguridad), pero
# el flujo es idéntico y los límites son mucho más altos.
#
# Producción: 5 fallos de validación por hora y 50 certificados por dominio y
# semana. Un DNS mal puesto con reintentos te bloquea durante horas.
#
# ⚠️ Al pasar de staging a producción hay que BORRAR el volumen de certificados,
# o Traefik seguirá sirviendo el de staging:
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml down
#     docker volume rm supercomparateca_letsencrypt
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Nota: docker-compose deriva DATABASE_URL (postgresql+psycopg://…@db:5432/…)
# y OCR_SERVICE_URL (http://ocr-service:8001) a partir de lo anterior.
# Para desarrollo local SIN docker, el api usa SQLite por defecto.
